rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==============================================
    // USER PROFILES
    // ==============================================

    match /users/{userId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['uid','displayName','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 30
        && request.resource.data.createdAt == request.time;

      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 30
        && request.resource.data.avatar is string
        && request.resource.data.avatar in
           ['diamond','gold','silver','emerald','ruby','royal']
        && (
          !request.resource.data.keys().hasAny(['picture'])
          || (
            request.resource.data.picture is string
            && request.resource.data.picture.size() <= 400000
          )
        );

      allow delete: if false;
    }

    // ==============================================
    // VIP-LOUNGE PUBLIC MESSAGES
    // ==============================================

    match /messages/{messageId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.keys().hasAll([
          'uid','username','channelId','text','timestamp'
        ])
        && request.resource.data.keys().hasOnly([
          'uid','username','channelId','text','timestamp','attachment'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.username.size() > 0
        && request.resource.data.username.size() <= 30
        && request.resource.data.channelId is string
        && request.resource.data.channelId.size() > 0
        && request.resource.data.channelId.size() <= 80
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.timestamp == request.time;

      allow update, delete: if false;
    }

    // ==============================================
    // CREATED SERVERS
    // ==============================================

    match /servers/{serverId} {

      allow read: if request.auth != null
        && request.auth.uid in resource.data.memberUids;

      allow create: if request.auth != null
        && request.resource.data.keys().hasAll([
          'name','nameLower','visibility','ownerUid','memberUids','createdAt'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 40
        && request.resource.data.nameLower is string
        && request.resource.data.visibility in ['private','public']
        && request.resource.data.createdAt == request.time;

      allow update, delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;

      // ============================================
      // SERVER ROLES
      // ============================================

      match /roles/{roleId} {

        function isServerMember() {
          return request.auth != null
            && request.auth.uid in get(
              /databases/$(database)/documents/servers/$(serverId)
            ).data.memberUids;
        }

        function isServerOwner() {
          return request.auth != null
            && request.auth.uid == get(
              /databases/$(database)/documents/servers/$(serverId)
            ).data.ownerUid;
        }

        allow read: if isServerMember();

        // Only the server owner can initialize roles
        allow create: if isServerOwner()
          && roleId in ['owner','admin','moderator','member']
          && request.resource.data.keys().hasAll([
            'name','nameLower','permissions','position','managed','createdAt'
          ])
          && request.resource.data.keys().hasOnly([
            'name','nameLower','permissions','position','managed','createdAt'
          ])
          && request.resource.data.name is string
          && request.resource.data.nameLower is string
          && request.resource.data.permissions is list
          && request.resource.data.position is number
          && request.resource.data.managed is bool
          && request.resource.data.createdAt == request.time;

        allow update, delete: if isServerOwner();
      }

      // ============================================
      // SERVER MEMBERS
      // ============================================

      match /members/{memberId} {

        function isServerMember() {
          return request.auth != null
            && request.auth.uid in get(
              /databases/$(database)/documents/servers/$(serverId)
            ).data.memberUids;
        }

        function isServerOwner() {
          return request.auth != null
            && request.auth.uid == get(
              /databases/$(database)/documents/servers/$(serverId)
            ).data.ownerUid;
        }

        allow read: if isServerMember();

        // Initialize the owner's membership only
        allow create: if isServerOwner()
          && memberId == request.auth.uid
          && request.resource.data.keys().hasAll([
            'uid','roleIds','joinedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'uid','roleIds','joinedAt'
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.roleIds == ['owner']
          && request.resource.data.joinedAt == request.time;

        // Only the server owner can manage memberships
        allow update, delete: if isServerOwner();
      }
    }

    // ==============================================
    // CREATED SERVER CHANNELS
    // ==============================================

    match /servers/{serverId}/channels/{channelId} {

      function isServerMember() {
        return request.auth != null
          && request.auth.uid in get(
            /databases/$(database)/documents/servers/$(serverId)
          ).data.memberUids;
      }

      allow read: if isServerMember();

      allow create: if isServerMember()
        && request.resource.data.keys().hasAll([
          'name','nameLower','type','createdBy','createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name','nameLower','type','createdBy','createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 40
        && request.resource.data.nameLower is string
        && request.resource.data.type in ['text','voice']
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;

      allow update, delete: if isServerMember()
        && get(
          /databases/$(database)/documents/servers/$(serverId)
        ).data.ownerUid == request.auth.uid;

      // ============================================
      // CREATED SERVER CHANNEL MESSAGES
      // ============================================

      match /messages/{messageId} {

        function isServerMember() {
          return request.auth != null
            && request.auth.uid in get(
              /databases/$(database)/documents/servers/$(serverId)
            ).data.memberUids;
        }

        allow read: if isServerMember();

        allow create: if isServerMember()
          && request.resource.data.keys().hasAll([
            'uid','username','text','timestamp'
          ])
          && request.resource.data.keys().hasOnly([
            'uid','username','text','timestamp'
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.username is string
          && request.resource.data.username.size() > 0
          && request.resource.data.username.size() <= 30
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.timestamp == request.time;

        allow update, delete: if false;
      }
    }

    // ==============================================
    // DIRECT MESSAGE CONVERSATIONS
    // ==============================================

    match /conversations/{conversationId} {

      allow get: if request.auth != null
        && (
          !exists(/databases/$(database)/documents/conversations/$(conversationId))
          || request.auth.uid in resource.data.participantUids
        );

      allow list: if false;

      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['participantUids','createdAt'])
        && request.resource.data.participantUids is list
        && request.resource.data.participantUids.size() == 2
        && request.auth.uid in request.resource.data.participantUids
        && request.resource.data.participantUids[0]
           != request.resource.data.participantUids[1]
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;

      match /messages/{messageId} {

        function isParticipant() {
          return request.auth != null
            && request.auth.uid in get(
              /databases/$(database)/documents/conversations/$(conversationId)
            ).data.participantUids;
        }

        allow read: if isParticipant();

        allow create: if isParticipant()
          && request.resource.data.keys().hasAll([
            'uid','username','text','timestamp'
          ])
          && request.resource.data.keys().hasOnly([
            'uid','username','text','timestamp'
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.username is string
          && request.resource.data.username.size() > 0
          && request.resource.data.username.size() <= 30
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.timestamp == request.time;

        allow update, delete: if false;
      }
    }

    // ==============================================
    // VOICE ROOM PARTICIPANTS
    // ==============================================

    match /voiceRooms/{roomId}/participants/{userId} {

      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.sessionId is string
        && request.resource.data.heartbeatAt is number;

      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }

    // ==============================================
    // VOICE CALL SIGNALING
    // ==============================================

    match /voiceRooms/{roomId}/calls/{callId} {

      allow read: if request.auth != null
        && (
          resource.data.callerUid == request.auth.uid
          || resource.data.calleeUid == request.auth.uid
        );

      allow create: if request.auth != null
        && request.resource.data.callerUid == request.auth.uid
        && request.resource.data.calleeUid is string
        && request.resource.data.calleeUid != request.auth.uid
        && request.resource.data.callerSessionId is string
        && request.resource.data.calleeSessionId is string
        && request.resource.data.createdAt is number;

      allow update: if request.auth != null
        && request.resource.data.callerUid == resource.data.callerUid
        && request.resource.data.calleeUid == resource.data.calleeUid
        && (
          (
            request.auth.uid == resource.data.callerUid
            && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['offer'])
          )
          ||
          (
            request.auth.uid == resource.data.calleeUid
            && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['answer'])
          )
        );

      allow delete: if request.auth != null
        && request.auth.uid == resource.data.callerUid;

      // ============================================
      // CALL ICE CANDIDATES
      // ============================================

      match /candidates/{candidateId} {

        function callData() {
          return get(
            /databases/$(database)/documents/voiceRooms/$(roomId)/calls/$(callId)
          ).data;
        }

        function isCallParticipant() {
          return request.auth != null
            && (
              callData().callerUid == request.auth.uid
              || callData().calleeUid == request.auth.uid
            );
        }

        allow read: if isCallParticipant();

        allow create: if isCallParticipant()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.candidate is map;

        allow update: if false;

        allow delete: if isCallParticipant()
          && resource.data.uid == request.auth.uid;
      }
    }
  }
}
