rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /messages/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['uid', 'username', 'text', 'timestamp'])
        && request.resource.data.keys().hasOnly(['uid', 'username', 'text', 'timestamp', 'attachment'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.username.size() > 0
        && request.resource.data.username.size() <= 30
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.timestamp == request.time
        && (
          !('attachment' in request.resource.data)
          || (
            request.resource.data.attachment is map
            && request.resource.data.attachment.keys().hasOnly(['name', 'type', 'url', 'size'])
            && request.resource.data.attachment.name is string
            && request.resource.data.attachment.name.size() > 0
            && request.resource.data.attachment.name.size() <= 120
            && request.resource.data.attachment.type is string
            && request.resource.data.attachment.type.matches('(image|video|audio)/.*')
            && request.resource.data.attachment.url is string
            && request.resource.data.attachment.url.matches('https://firebasestorage\\.googleapis\\.com/.*')
            && request.resource.data.attachment.size is number
            && request.resource.data.attachment.size > 0
            && request.resource.data.attachment.size <= 25 * 1024 * 1024
          )
        );
      allow update, delete: if false;
    }

    match /voiceRooms/{roomId}/participants/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.sessionId is string
        && request.resource.data.heartbeatAt is number;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /voiceRooms/{roomId}/calls/{callId} {
      allow read: if request.auth != null
        && (resource.data.callerUid == request.auth.uid
          || resource.data.calleeUid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.callerUid == request.auth.uid
        && request.resource.data.calleeUid is string
        && request.resource.data.calleeUid != request.auth.uid
        && request.resource.data.callerSessionId is string
        && request.resource.data.calleeSessionId is string
        && request.resource.data.offer == null
        && request.resource.data.answer == null
        && request.resource.data.createdAt is number;
      allow update: if request.auth != null
        && request.resource.data.callerUid == resource.data.callerUid
        && request.resource.data.calleeUid == resource.data.calleeUid
        && (
          (request.auth.uid == resource.data.callerUid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['offer'])
            && request.resource.data.offer is map
            && request.resource.data.offer.type == 'offer'
            && request.resource.data.offer.sdp is string)
          ||
          (request.auth.uid == resource.data.calleeUid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer'])
            && request.resource.data.answer is map
            && request.resource.data.answer.type == 'answer'
            && request.resource.data.answer.sdp is string)
        );
      allow delete: if request.auth != null && request.auth.uid == resource.data.callerUid;

      match /candidates/{candidateId} {
        function callData() {
          return get(/databases/$(database)/documents/voiceRooms/$(roomId)/calls/$(callId)).data;
        }
        function isCallParticipant() {
          return request.auth != null
            && (callData().callerUid == request.auth.uid
              || callData().calleeUid == request.auth.uid);
        }
        allow read: if isCallParticipant();
        allow create: if isCallParticipant()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.candidate is map;
        allow update: if false;
        allow delete: if isCallParticipant() && resource.data.uid == request.auth.uid;
      }
    }
  }
}
