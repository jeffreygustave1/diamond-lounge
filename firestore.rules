rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isGuest() { return request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous'; }
    function isMemberAccount() { return request.auth != null && !isGuest(); }

    match /users/{userId} {
      allow read: if request.auth != null;

      allow create: if isMemberAccount()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll([
          'uid', 'displayName', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 30
        && request.resource.data.createdAt == request.time;

      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 30
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'avatar', 'picture', 'badges', 'updatedAt'
        ])
        && (!('avatar' in request.resource.data) || request.resource.data.avatar is string)
        && (!('picture' in request.resource.data) || request.resource.data.picture is string)
        && (!('badges' in request.resource.data)
          || (request.resource.data.badges is list && request.resource.data.badges.size() <= 4))
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt == request.time);
      allow delete: if false;
    }

    match /messages/{messageId} {
      allow read: if request.auth != null;

      allow create: if isMemberAccount()
        && request.resource.data.keys().hasAll([
          'uid', 'username', 'channelId', 'text', 'timestamp'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'channelId', 'text', 'timestamp',
          'attachment'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.username.size() > 0
        && request.resource.data.username.size() <= 30
        && request.resource.data.channelId is string
        && request.resource.data.channelId.size() > 0
        && request.resource.data.channelId.size() <= 80
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.timestamp == request.time;

      allow update, delete: if false;
    }

    match /servers/{serverId} {
      // Members can list only servers they belong to. Direct gets are needed
      // to resolve invite URLs before membership is established.
      allow get: if request.auth != null;
      allow list: if request.auth != null
        && request.auth.uid in resource.data.memberUids;

      allow create: if request.auth != null
        && request.resource.data.keys().hasAll([
          'name',
          'nameLower',
          'visibility',
          'ownerUid',
          'memberUids',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name',
          'nameLower',
          'visibility',
          'ownerUid',
          'memberUids',
          'createdAt'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.size() == 1
        && request.resource.data.memberUids[0] == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 40
        && request.resource.data.nameLower is string
        && request.resource.data.visibility in ['private', 'public']
        && request.resource.data.createdAt == request.time;

      allow update: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
          && request.resource.data.memberUids is list
          && request.auth.uid in request.resource.data.memberUids
          && !(request.auth.uid in resource.data.memberUids)
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && exists(/databases/$(database)/documents/servers/$(serverId)/joinRequests/$(request.auth.uid))
          && get(/databases/$(database)/documents/servers/$(serverId)/joinRequests/$(request.auth.uid)).data.uid == request.auth.uid
        )
      );
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      function isServerMember() {
        return request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/servers/$(serverId)).data.memberUids;
      }
      function isServerOwner() {
        return request.auth != null
          && get(/databases/$(database)/documents/servers/$(serverId)).data.ownerUid == request.auth.uid;
      }
      function hasServerPermission(permission) {
        let memberPath = /databases/$(database)/documents/servers/$(serverId)/members/$(request.auth.uid);
        return isServerMember()
          && exists(memberPath)
          && (
            (get(memberPath).data.permissions is list
              && get(memberPath).data.permissions.hasAny(['*', permission]))
            || permission in ['viewChannels', 'sendMessages', 'connectVoice', 'speak']
          );
      }

      match /roles/{roleId} {
        allow read: if isServerMember();
        allow create, update, delete: if isServerOwner();
      }

      match /members/{memberUid} {
        allow read: if isServerMember();
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['uid', 'displayName', 'roleIds', 'permissions', 'joinedAt'])
          && request.resource.data.uid == memberUid
          && request.resource.data.roleIds is list
          && (
            (
              request.auth.uid == memberUid
              && isServerMember()
              && !isServerOwner()
              && request.resource.data.roleIds.size() == 1
              && request.resource.data.roleIds[0] == 'member'
              && request.resource.data.permissions is list
              && request.resource.data.permissions.hasOnly(['viewChannels', 'sendMessages', 'connectVoice', 'speak'])
            )
            ||
            (
              isServerOwner()
              && memberUid in get(/databases/$(database)/documents/servers/$(serverId)).data.memberUids
              && request.resource.data.roleIds.size() <= 20
              && request.resource.data.permissions is list
              && request.resource.data.permissions.size() <= 40
            )
          );
        allow update: if (
          isServerOwner()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roleIds', 'permissions'])
          && request.resource.data.roleIds is list
          && request.resource.data.roleIds.size() <= 20
          && request.resource.data.permissions is list
          && request.resource.data.permissions.size() <= 40
        ) || (
          request.auth != null
          && request.auth.uid == memberUid
          && isServerMember()
          && request.resource.data.uid == memberUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'joinedAt'])
        );
        allow delete: if request.auth != null
          && (request.auth.uid == memberUid || isServerOwner());
      }

      match /channels/{channelId} {
        allow read: if isServerMember();
        allow create: if isServerMember()
          && (isServerOwner() || hasServerPermission('manageChannels'))
          && request.resource.data.keys().hasOnly([
            'name', 'nameLower', 'type', 'createdBy', 'createdAt', 'parentCategoryId'
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 40
          && request.resource.data.nameLower is string
          && request.resource.data.type in ['text', 'voice', 'category']
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update: if isServerOwner() || (
          hasServerPermission('manageChannels')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'nameLower'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 40
          && request.resource.data.nameLower is string
        );
        allow delete: if isServerOwner() || hasServerPermission('manageChannels');

        match /messages/{messageId} {
          allow read: if isServerMember();
          allow create: if isServerMember()
            && (isServerOwner() || hasServerPermission('sendMessages'))
            && request.resource.data.keys().hasOnly([
              'uid', 'username', 'displayName', 'text', 'timestamp'
            ])
            && request.resource.data.uid == request.auth.uid
            && (
              ('username' in request.resource.data
                && request.resource.data.username is string
                && request.resource.data.username.size() > 0
                && request.resource.data.username.size() <= 30)
              || ('displayName' in request.resource.data
                && request.resource.data.displayName is string
                && request.resource.data.displayName.size() > 0
                && request.resource.data.displayName.size() <= 30)
            )
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 2000
            && request.resource.data.timestamp == request.time;
          allow update, delete: if isServerOwner() || hasServerPermission('manageMessages');
        }
      }

      match /events/{eventId} {
        allow read: if isServerMember();
        allow create: if isServerMember()
          && (isServerOwner() || hasServerPermission('manageEvents'))
          && request.resource.data.keys().hasOnly([
            'title', 'startsAt', 'details', 'createdBy', 'createdAt'
          ])
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 1
          && request.resource.data.title.size() <= 80
          && request.resource.data.startsAt is string
          && request.resource.data.startsAt.size() <= 40
          && request.resource.data.details is string
          && request.resource.data.details.size() <= 1000
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update: if isServerOwner() || (
          hasServerPermission('manageEvents')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'startsAt', 'details'])
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 1
          && request.resource.data.title.size() <= 80
          && request.resource.data.startsAt is string
          && request.resource.data.startsAt.size() <= 40
          && request.resource.data.details is string
          && request.resource.data.details.size() <= 1000
        );
        allow delete: if isServerOwner() || hasServerPermission('manageEvents');
      }

      match /invites/{inviteCode} {
        // Invitees fetch a known code from the link; invite collections cannot be enumerated.
        allow get: if request.auth != null;
        allow list: if false;
        allow create: if isServerMember()
          && request.auth != null
          && request.resource.data.keys().hasAll(['code', 'createdBy', 'createdAt', 'channelId'])
          && request.resource.data.keys().hasOnly(['code', 'createdBy', 'createdAt', 'channelId'])
          && request.resource.data.code is string
          && request.resource.data.code == inviteCode
          && request.resource.data.code.size() >= 10
          && request.resource.data.code.size() <= 40
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && (request.resource.data.channelId == null || request.resource.data.channelId is string);
        allow update: if false;
        allow delete: if isServerOwner() || hasServerPermission('manageInvites');
      }

      match /joinRequests/{memberUid} {
        allow create: if request.auth != null
          && request.auth.uid == memberUid
          && request.resource.data.keys().hasOnly(['uid', 'inviteCode', 'createdAt'])
          && request.resource.data.uid == memberUid
          && request.resource.data.inviteCode is string
          && request.resource.data.inviteCode.size() >= 10
          && request.resource.data.inviteCode.size() <= 40
          && request.resource.data.createdAt == request.time
          && exists(/databases/$(database)/documents/servers/$(serverId)/invites/$(request.resource.data.inviteCode));
        allow read: if isServerOwner();
        allow update: if false;
        allow delete: if request.auth != null
          && (request.auth.uid == memberUid || isServerOwner());
      }
    }

    match /conversations/{conversationId} {
      allow get: if request.auth != null
        && (
          !exists(
            /databases/$(database)/documents/conversations/$(conversationId)
          )
          || request.auth.uid in resource.data.participantUids
        );

      allow list: if false;

      allow create: if isMemberAccount()
        && request.resource.data.keys().hasAll([
          'participantUids', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'participantUids', 'createdAt'
        ])
        && request.resource.data.participantUids is list
        && request.resource.data.participantUids.size() == 2
        && request.auth.uid in request.resource.data.participantUids
        && request.resource.data.participantUids[0]
          != request.resource.data.participantUids[1]
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;

      match /messages/{messageId} {
        function isConversationParticipant() {
          return request.auth != null
            && request.auth.uid in get(
              /databases/$(database)/documents/conversations/$(conversationId)
            ).data.participantUids;
        }

        allow read: if isConversationParticipant();

        allow create: if isMemberAccount() && isConversationParticipant()
          && request.resource.data.keys().hasAll([
            'uid', 'username', 'text', 'timestamp'
          ])
          && request.resource.data.keys().hasOnly([
            'uid', 'username', 'text', 'timestamp'
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.username is string
          && request.resource.data.username.size() > 0
          && request.resource.data.username.size() <= 30
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.timestamp == request.time;

        allow update, delete: if false;
      }
    }

    match /voiceRooms/{roomId}/participants/{userId} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.sessionId is string
        && request.resource.data.heartbeatAt is number;

      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }

    match /voiceRooms/{roomId}/watch/state {
      function isVoiceParticipant() {
        return request.auth != null
          && exists(/databases/$(database)/documents/voiceRooms/$(roomId)/participants/$(request.auth.uid));
      }
      allow read: if isVoiceParticipant();
      allow create, update: if isVoiceParticipant()
        && request.resource.data.keys().hasOnly(['videoId', 'action', 'position', 'updatedAt', 'updatedBy'])
        && (request.resource.data.videoId == null || request.resource.data.videoId is string)
        && request.resource.data.action in ['play', 'pause', 'clear']
        && request.resource.data.position is number
        && request.resource.data.updatedAt is number
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;

      match /messages/{messageId} {
        function isVoiceParticipant() {
          return request.auth != null
            && exists(/databases/$(database)/documents/voiceRooms/$(roomId)/participants/$(request.auth.uid));
        }
        allow read: if isVoiceParticipant();
        allow create: if isVoiceParticipant()
          && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /voiceRooms/{roomId}/calls/{callId} {
      allow read: if request.auth != null
        && (
          resource.data.callerUid == request.auth.uid
          || resource.data.calleeUid == request.auth.uid
        );

      allow create: if request.auth != null
        && request.resource.data.callerUid == request.auth.uid
        && request.resource.data.calleeUid is string
        && request.resource.data.calleeUid != request.auth.uid
        && request.resource.data.callerSessionId is string
        && request.resource.data.calleeSessionId is string
        && request.resource.data.offer == null
        && request.resource.data.answer == null
        && request.resource.data.createdAt is number;

      allow update: if request.auth != null
        && request.resource.data.callerUid == resource.data.callerUid
        && request.resource.data.calleeUid == resource.data.calleeUid
        && (
          (
            request.auth.uid == resource.data.callerUid
            && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['offer'])
            && request.resource.data.offer is map
            && request.resource.data.offer.type == 'offer'
            && request.resource.data.offer.sdp is string
          )
          ||
          (
            request.auth.uid == resource.data.calleeUid
            && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['answer'])
            && request.resource.data.answer is map
            && request.resource.data.answer.type == 'answer'
            && request.resource.data.answer.sdp is string
          )
        );

      allow delete: if request.auth != null
        && request.auth.uid == resource.data.callerUid;

      match /candidates/{candidateId} {
        function callData() {
          return get(
            /databases/$(database)/documents/voiceRooms/$(roomId)/calls/$(callId)
          ).data;
        }

        function isCallParticipant() {
          return request.auth != null
            && (
              callData().callerUid == request.auth.uid
              || callData().calleeUid == request.auth.uid
            );
        }

        allow read: if isCallParticipant();

        allow create: if isCallParticipant()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.candidate is map;

        allow update: if false;

        allow delete: if isCallParticipant()
          && resource.data.uid == request.auth.uid;
      }
    }

    // Private DM calling: each call is visible only to its two participants.
    match /dmCalls/{callId} {
      function isParticipant() {
        return request.auth != null
          && request.auth.uid in resource.data.participants;
      }
      allow read: if isParticipant();
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['callerUid','calleeUid','callerName','participants','callType','status','createdAt'])
        && request.resource.data.callerUid == request.auth.uid
        && request.resource.data.calleeUid is string
        && request.resource.data.calleeUid != request.auth.uid
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants.hasAll([request.auth.uid,request.resource.data.calleeUid])
        && request.resource.data.callType in ['audio','video']
        && request.resource.data.status == 'ringing'
        && request.resource.data.createdAt == request.time;
      allow update: if isParticipant() && (
        (request.auth.uid == resource.data.callerUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['offer'])
          && request.resource.data.offer is map
          && request.resource.data.offer.type == 'offer'
          && request.resource.data.offer.sdp is string)
        || (request.auth.uid == resource.data.calleeUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer','status'])
          && request.resource.data.answer is map
          && request.resource.data.answer.type == 'answer'
          && request.resource.data.answer.sdp is string
          && request.resource.data.status == 'accepted')
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['ended','declined'])
      );
      allow delete: if false;
      match /{candidateCollection}/{candidateId} {
        function parentCall() {
          return get(/databases/$(database)/documents/dmCalls/$(callId)).data;
        }
        function participant() {
          return request.auth != null && request.auth.uid in parentCall().participants;
        }
        allow read: if participant() && candidateCollection in ['callerCandidates','calleeCandidates'];
        allow create: if participant()
          && candidateCollection in ['callerCandidates','calleeCandidates']
          && request.resource.data.keys().hasOnly(['candidate'])
          && request.resource.data.candidate is map;
        allow update, delete: if false;
      }
    }
    // Premium cosmetics entitlements: user can read their own flags; client writes forbidden.
    match /premiumEntitlements/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
  }
}
